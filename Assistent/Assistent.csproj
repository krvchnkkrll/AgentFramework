<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Assistant</AssemblyName>
        <RootNamespace>Assistant</RootNamespace>
        <!--
          MEAI001  — чат-редьюсеры Microsoft.Extensions.AI помечены как experimental.
          OPENAI001 — клиент Responses API (нужен для Yandex AI Studio) тоже помечен как experimental.
          MAAI001  — почти весь «взрослый» Microsoft Agent Framework: компакция, скиллы, todo,
                     режимы, файловые сторы, аппрувы инструментов, LoopAgent. Это не превью-пакет,
                     а помеченные [Experimental] API внутри стабильного — сигнатуры могут поехать
                     между минорными версиями, поэтому обновлять пакет нужно осознанно.
        -->
        <NoWarn>$(NoWarn);MEAI001;OPENAI001;MAAI001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Agents.AI" />
      <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
      <PackageReference Include="Microsoft.Agents.AI.Workflows" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Http" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Options" />
      <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Assistant.Contracts\Assistant.Contracts.csproj" />
    </ItemGroup>

</Project>
