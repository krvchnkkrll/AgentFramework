# Значения по умолчанию для `npm run dev`.
# Личные переопределения клади в .env.development.local — он в .gitignore.
# (не .env.local — у Vite .env.development перекрывает его, а не наоборот)

VITE_KEYCLOAK_URL=http://192.168.0.14:8080
VITE_KEYCLOAK_REALM=Workspace
VITE_KEYCLOAK_CLIENT_ID=agentframework-web

# Клиент agentframework-web в realm Workspace уже заведён (публичный, PKCE S256).
# Общий дефолт остаётся true, чтобы у остальных не ломался запуск без Keycloak —
# кому нужен реальный логин, включает false в .env.development.local.
VITE_AUTH_DISABLED=true

# Эндпоинты чатов на бэкенде уже есть — работаем через реальный API.
VITE_USE_MOCKS=false

# https-профиль ASP.NET Core (Web/Properties/launchSettings.json). http-профиля
# в проекте больше нет — самоподписанный сертификат proxy игнорирует (secure: false).
VITE_API_PROXY_TARGET=https://localhost:7128
