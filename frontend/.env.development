# Значения по умолчанию для `npm run dev`.
# Личные переопределения клади в .env.local — он в .gitignore.

VITE_KEYCLOAK_URL=https://192.168.0.14:8080
VITE_KEYCLOAK_REALM=workspace
VITE_KEYCLOAK_CLIENT_ID=agentframework-web

# Пока клиента в Keycloak нет — стартуем без авторизации.
# Как создашь клиента, поставь false.
VITE_AUTH_DISABLED=true

# Реальных эндпоинтов чатов ещё нет — работаем на моках.
VITE_USE_MOCKS=true

VITE_API_PROXY_TARGET=http://localhost:5175
