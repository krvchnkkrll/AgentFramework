# Скопируй в .env.local и поправь под себя.

# --- Keycloak ---
VITE_KEYCLOAK_URL=https://192.168.0.14:8080
VITE_KEYCLOAK_REALM=workspace
VITE_KEYCLOAK_CLIENT_ID=agentframework-web

# --- Режимы разработки ---
# true  -> авторизация выключена, работаем под фейковым пользователем (Keycloak не нужен)
# false -> реальный логин через Keycloak
VITE_AUTH_DISABLED=true

# true  -> чаты/сообщения/вложения берутся из мок-слоя в браузере
# false -> фронт ходит в реальные /api/chats, /api/chats/{id}/messages и т.д.
VITE_USE_MOCKS=true

# Куда vite проксирует /api в dev-режиме (http-профиль Web-проекта)
VITE_API_PROXY_TARGET=http://localhost:5175
