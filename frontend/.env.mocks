# Режим «фронт без бэкенда»: npm run dev -- --mode mocks
#
# Vite при --mode mocks читает .env и .env.mocks, но НЕ читает .env.development,
# поэтому все нужные переменные перечислены здесь целиком.
#
# Нужен, чтобы проверять UI (в том числе индикацию вызовов инструментов) без поднятого
# ASP.NET Core, Postgres, Keycloak и LM Studio.

VITE_AUTH_DISABLED=true
VITE_USE_MOCKS=true

# Не используются в этом режиме, но пусть будут заполнены — config.ts их читает всегда.
VITE_KEYCLOAK_URL=http://192.168.0.14:8080
VITE_KEYCLOAK_REALM=Workspace
VITE_KEYCLOAK_CLIENT_ID=agentframework-web
VITE_API_PROXY_TARGET=https://localhost:7128
